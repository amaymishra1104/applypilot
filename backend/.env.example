# Backend environment variables for ApplyPilot
# Copy to .env and fill in real values. Never commit .env with real secrets.

MONGO_URL=mongodb://localhost:27017
DB_NAME=applypilot
CORS_ORIGINS=*

# Single-user owner authentication (generate hash with: python scripts/hash_password.py)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SECURE_COOKIES=false

# Direct LLM provider (default: gemini; selectable: gemini, openai, anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Set the API key for your chosen provider:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CONCURRENCY=5
LLM_TIMEOUT=60

# Storage backend (default: local; selectable: local, s3)
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
# Optional S3-compatible configuration (for AWS S3 or Cloudflare R2):
# S3_BUCKET=applypilot-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Emergent managed email (owner notifications only)
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=ApplyPilot
EMAIL_REPLY_TO=you@example.com

# In-process APScheduler background automation (true in dev/prod, false in test)
SCHEDULER_ENABLED=true

# Scheduled task auth (generate: python3 -c "import secrets;print(secrets.token_hex(24))")
WEBHOOK_CRON_SECRET=

# Encryption key for stored OAuth tokens (generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=

# Optional fallback Google OAuth credentials (per-user credentials are configured in-app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
