# Backend environment variables for ApplyPilot
# Copy to backend/.env and fill in real values. Never commit .env with real secrets.

MONGO_URL=mongodb://localhost:27017
DB_NAME=applypilot
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dry-run simulation mode (default: true for safety; set to false for real Gmail sending)
DRY_RUN=true

# Single-user owner authentication (REQUIRED)
# 1. Generate password hash: python scripts/hash_password.py
#    (Note: If running via Docker Compose, escape $ signs as $$: e.g. $$2b$$12$$...)
# 2. Generate session secret: python -c "import secrets; print(secrets.token_hex(32))"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SECURE_COOKIES=false

# Encryption key for stored OAuth tokens (REQUIRED)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Direct LLM provider (default: gemini; selectable: gemini, openai, anthropic, groq)
# Recommended models:
#   Gemini:    gemini-2.5-flash, gemini-2.5-pro, gemini-3.6-flash, gemini-2.0-flash
#   OpenAI:    gpt-5, gpt-5.4, gpt-4o, gpt-4o-mini
#   Anthropic: claude-sonnet-5-5, claude-haiku-5-5
#   Groq:      openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Set the API key for your chosen provider:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_CONCURRENCY=5
LLM_TIMEOUT=60

# Storage backend (default: local; selectable: local, s3)
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
# Optional S3-compatible configuration (for AWS S3 or Cloudflare R2):
# S3_BUCKET=applypilot-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# In-process APScheduler background automation (true in dev/prod, false in test)
SCHEDULER_ENABLED=true

# Google OAuth credentials for sending via your Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Owner notification delivery settings (connected Gmail is used first if available)
# Optional SMTP configuration fallback:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
EMAIL_FROM_NAME=ApplyPilot
EMAIL_REPLY_TO=owner@example.com

# Webhook secret for manual triggering of cron endpoints
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_CRON_SECRET=
